{
  "name": "typescript-essential",
  "private": "false",
  "version": "1.0.0",
  "description": "TypeScript Essential - An Essential Starter Template for Development of TypeScript.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "bin": {
    "typescript-essential": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm rimraf dist && tsdown",
    "dev": "pnpm run build && node dist/index.js",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "pub:latest": "changeset publish",
    "build:prepare": "pnpm run typecheck && pnpm run lint && pnpm run format && pnpm run check && pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^24.10.1",
    "husky": "^9.1.7",
    "rimraf": "^6.1.2",
    "tsdown": "^0.16.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  },
  "packageManager": "pnpm@10.23.0"
}
